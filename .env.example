# =====================================================
# PROCURIX — ENVIRONMENT TEMPLATE
# Copy this file to .env.local and fill in your values.
#   cp .env.example .env.local
# See START.md for where to get each value.
# =====================================================

# ---------- SUPABASE ----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_REPORTS_BUCKET=reports

# ---------- AI MODEL (Gemini) ----------
# LangChain reads this by name. Must be spelled exactly.
GOOGLE_API_KEY=

# ---------- GOOGLE LOGIN ----------
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
JWT_SECRET=

# ---------- GMAIL SENDING ----------
# Same client ID as above, different callback.
GOOGLE_CLIENT_ID=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/gmail/callback

# ---------- APP URLS ----------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000

# ---------- SCHEDULED JOBS ----------
# Any long random string. The daily compliance watcher refuses to run without it.
CRON_SECRET=

# ---------- DEMO MODE ----------
# true = unlimited credits and no upgrade modal. Use for demos.
NEXT_PUBLIC_DEMO_MODE=false

# ---------- EMAIL FALLBACK (optional) ----------
SENDER_EMAIL=
SENDER_PASSWORD=

# ---------- PAYMENTS (optional) ----------
NEXT_PUBLIC_LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_API_KEY=
NEXT_PUBLIC_LEMON_SQUEEZY_STORE_DOMAIN=
NEXT_PUBLIC_LEMON_SQUEEZY_VARIANT_ID_TOPUP_URL=
NEXT_PUBLIC_LEMON_SQUEEZY_VARIANT_ID_PLUS_URL=
LEMON_SQUEEZY_VARIANT_ID_TOPUP=
LEMON_SQUEEZY_VARIANT_ID_PLUS=

# ---------- ANALYTICS (optional) ----------
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
